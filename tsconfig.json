{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	// SvelteKit 3 generates the parent config (paths, rootDirs, $app types, lib,
	// module settings) into node_modules/$app/tsconfig.json on `svelte-kit sync`.
	// The service worker runs in a different global scope (WebWorker, no DOM), so
	// it's excluded here and checked by its own src/service-worker/tsconfig.json,
	// which extends $app/tsconfig/service-worker.
	"include": ["src", "tests", "*.ts"],
	"exclude": ["src/service-worker"]
}
