{
  "name": "stale-mates",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun run test:integration && bun run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . && node scripts/sync-protocol.mjs --check",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "api": "cd api && bun run dev",
    "api:build": "cd api && bun run build",
    "dev:all": "concurrently \"bun run dev\" \"bun run api\"",
    "format:check": "prettier --check .",
    "protocol:sync": "node scripts/sync-protocol.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-vercel": "^5.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3",
    "globals": "^17.6.0",
    "postcss": "^8.4.39",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.1.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4",
    "tailwindcss": "^3.4.4",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0-alpha.20",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "dependencies": {
    "bits-ui": "^0.21.13",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^0.3.1",
    "svelte-radix": "^1.1.0",
    "tailwind-merge": "^2.3.0",
    "tailwind-variants": "^0.2.1",
    "vaul-svelte": "^0.3.2"
  },
  "engines": {
    "node": ">=20.19 <25"
  }
}
