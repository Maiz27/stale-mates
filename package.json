{
  "name": "stale-mates",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun run test:integration && bun run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . && node scripts/sync-protocol.mjs --check",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "api": "cd api && bun run dev",
    "api:build": "cd api && bun run build",
    "dev:all": "concurrently \"bun run dev\" \"bun run api\"",
    "format:check": "prettier --check .",
    "protocol:sync": "node scripts/sync-protocol.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.53.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-vercel": "^7",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tailwindcss/vite": "^4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22",
    "concurrently": "^10.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3",
    "globals": "^17.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.4.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8",
    "vitest": "^5"
  },
  "type": "module",
  "dependencies": {
    "bits-ui": "^2.18.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte-radix": "^3.0.2",
    "tailwind-merge": "^3",
    "tailwind-variants": "^3.3.0",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "engines": {
    "node": ">=22.17 <25"
  }
}
