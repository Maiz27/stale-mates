# Allowed frontend origin(s) for CORS and the WebSocket Origin check (comma-separated). Defaults to http://localhost:5173 in dev.
# REQUIRED in production (NODE_ENV=production) — startup fails fast if unset.
ORIGIN=http://localhost:5173

# Port the HTTP/WebSocket server listens on. Optional; defaults to 3000.
# Must be an integer 1-65535 if set.
PORT=3000

# Abandoned-room sweep TTL in milliseconds. Optional; defaults to 1800000 (30 min).
# Rooms older than this with no connected players are reaped to bound memory.
# Must be a positive integer if set.
# ROOM_TTL_MS=1800000

# How long a disconnected player has to come back before the opponent may claim the
# win by abandonment, in ms. Optional; defaults to 60000.
# DISCONNECT_GRACE_MS=60000

# Reverse-proxy hops to trust for the client IP in X-Forwarded-For (per-IP limits).
# Optional; defaults to 1 (Fly.io's edge proxy). Use 0 when the server is exposed
# directly, otherwise clients can spoof their IP. Non-negative integer.
# TRUST_PROXY=1

# Concurrent WebSocket connections allowed per client IP. Optional; defaults to 20.
# MAX_WS_CONNECTIONS_PER_IP=20
