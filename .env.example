# Backend URLs baked into the build. In Vercel, set them for Production only (recommended:
# previews are then AI-only). Setting them for Preview needs ORIGIN_PATTERNS on the backend,
# which on vercel.app is only a soft guard: anyone can name a Vercel project so that its
# <name>.vercel.app URL matches the pattern — see README.
VITE_API_URL=http://localhost:3000
VITE_API_WS_URL=ws://localhost:3000